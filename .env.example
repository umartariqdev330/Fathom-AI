# Backend ----------------------------------------------------------------
# SQLite by default. Point at Postgres to use it instead:
#   postgresql+psycopg://user:password@host:5432/meetly
DATABASE_URL=sqlite:///./meetly.db

# Optional. Without it, summaries come from the built-in fallback summariser
# and the product works exactly the same.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Frontend ---------------------------------------------------------------
# Empty in development: Vite proxies /api to the local backend.
# In production set it to the deployed API origin, e.g. https://meetly-api.onrender.com
VITE_API_URL=

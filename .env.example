# Backend ----------------------------------------------------------------

# SQLite by default. Point at Postgres to use it instead:
#   postgresql+psycopg://user:password@host:5432/meetly
DATABASE_URL=sqlite:///./meetly.db

# Enables real transcription (Whisper) and real LLM summaries.
# Without it the app still runs: summaries fall back to local extraction and
# transcription is skipped with a visible notice rather than faked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1

# Where uploaded recordings are written. Relative paths resolve from backend/.
MEDIA_STORAGE_PATH=media
MAX_UPLOAD_MB=50

# Speaker label applied to transcripts. The Whisper API does not do speaker
# diarization, so every segment of a recording carries this name.
DEFAULT_SPEAKER=Speaker 1

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Frontend ---------------------------------------------------------------
# Empty in development: Vite proxies /api to the local backend.
# In production set it to the deployed API origin.
VITE_API_URL=
